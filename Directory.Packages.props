<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Hosting / DI (SAD §81, Implementation Plan §16) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
  </ItemGroup>

  <!-- Logging (Implementation Plan §17) -->
  <ItemGroup>
    <PackageVersion Include="Serilog" Version="4.2.0" />
    <PackageVersion Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageVersion Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageVersion Include="Serilog.Sinks.Debug" Version="3.0.0" />
  </ItemGroup>

  <!-- Desktop UI: MVVM (Implementation Plan §15) -->
  <ItemGroup>
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.0" />
  </ItemGroup>

  <!-- Persistence: SQLite via Dapper + FluentMigrator (SAD §28, Implementation Plan §10) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageVersion Include="Dapper" Version="2.1.66" />
    <PackageVersion Include="FluentMigrator" Version="7.1.0" />
    <PackageVersion Include="FluentMigrator.Runner" Version="7.1.0" />
    <PackageVersion Include="FluentMigrator.Runner.SQLite" Version="7.1.0" />
    <!-- Microsoft.Data.Sqlite 10.0.0 transitively pulls SQLitePCLRaw.lib.e_sqlite3 2.1.11,
         which has a known high-severity advisory (GHSA-2m69-gcr7-jv3q). Pinned to a fixed
         version here; CentralPackageTransitivePinningEnabled applies it without needing a
         direct PackageReference in every consuming project. -->
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- Security: Argon2id password hashing (DB Spec §19, decision log EXECUTION_PLAN §2.5), DPAPI secrets (Implementation Plan §94) -->
  <ItemGroup>
    <PackageVersion Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <!-- Phase 12 (Plugin Platform): CMS/PKCS#7 package-signature verification (Implementation Plan decision log — "CMS/PKCS#7 X.509 package signing") -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.11" />
  </ItemGroup>

  <!-- Phase 10 (Importers): text/metadata extraction per format, none touch the UI process (Implementation Plan §54-58) -->
  <ItemGroup>
    <PackageVersion Include="PdfPig" Version="0.1.16" />
    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageVersion Include="MimeKit" Version="4.17.0" />
    <PackageVersion Include="MsgReader" Version="6.1.1" />
  </ItemGroup>

  <!-- Phase 11 (Preview): PDF preview via WebView2's built-in Chromium PDF viewer against local files, no server/internet needed (Implementation Plan §59) -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- Phase 15 (OCR): Tesseract is the official OCR provider per master documentation §41.3; PDFsharp imports original pages and adds the invisible text layer without replacing their visual content. -->
  <ItemGroup>
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
  </ItemGroup>

  <!-- Phase 14 official scanner provider per master doc §38.1. -->
  <ItemGroup>
    <PackageVersion Include="NAPS2.Sdk" Version="1.3.0" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

</Project>
