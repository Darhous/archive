<Window x:Class="Darhous.Archive.Desktop.Views.AiSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إعدادات الذكاء الاصطناعي"
        Height="620" Width="640"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="الذكاء الاصطناعي السحابي" Style="{StaticResource BrandHeadingText}" />

        <!-- The warning itself never disappears. Acknowledgment only unlocks provider toggles;
             closing this window without checking it leaves every provider disabled in the service. -->
        <Border Grid.Row="2" Padding="16" CornerRadius="4" BorderThickness="1"
                BorderBrush="{DynamicResource AccentBrush}" Background="{DynamicResource SecondarySurfaceBrush}">
            <StackPanel>
                <TextBlock Text="تحذير الخصوصية الإلزامي" FontWeight="Bold"
                           Foreground="{DynamicResource PrimaryTextBrush}" />
                <TextBlock Margin="0,8,0,12" TextWrapping="Wrap" Style="{StaticResource BodyText}"
                           Text="عند تثبيت وتفعيل موفر سحابي مستقبلًا، قد تغادر النصوص أو بيانات المستند جهازك وتُعالج وفق سياسة ذلك الموفر. لا تُفعّل أي موفر قبل مراجعة سياسة الخصوصية ومتطلبات مؤسستك. لا تتضمن هذه المرحلة أي موفر أو اتصال شبكي فعلي." />
                <CheckBox Content="قرأت التحذير وأوافق على السماح بتفعيل موفري AI السحابيين"
                          IsChecked="{Binding PrivacyAcknowledged}" />
            </StackPanel>
        </Border>

        <TextBlock Grid.Row="4" TextWrapping="Wrap" Style="{StaticResource SecondaryText}"
                   Text="لا تتضمن Phase 20 موفرًا رسميًا. ستظهر إضافات الموفّرين المثبتة هنا عند توفرها." />

        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox Grid.Row="0" ItemsSource="{Binding Providers}"
                     Background="{DynamicResource PrimarySurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <CheckBox Content="{Binding ProviderId}" IsChecked="{Binding IsEnabled}"
                                  IsEnabled="{Binding DataContext.CanEnableProviders, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="1" Margin="0,12,0,4" Text="الموفر النشط" Style="{StaticResource SecondaryText}" />
            <ComboBox Grid.Row="3" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}"
                      DisplayMemberPath="ProviderId" IsEnabled="{Binding CanEnableProviders}" />

            <Grid Grid.Row="5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Margin="0,0,0,4" Text="مفتاح API للموفر النشط" Style="{StaticResource SecondaryText}" />
                    <PasswordBox x:Name="ApiKeyBox" IsEnabled="{Binding CanSaveApiKey}" />
                </StackPanel>
                <Button Grid.Column="2" Content="حفظ المفتاح" Style="{StaticResource PrimaryButton}"
                        VerticalAlignment="Bottom" Click="SaveApiKey_Click" IsEnabled="{Binding CanSaveApiKey}" />
            </Grid>
        </Grid>

        <TextBlock Grid.Row="6" Text="{Binding StatusMessage}" TextWrapping="Wrap"
                   Style="{StaticResource SecondaryText}" />

        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Left">
            <Button Content="إغلاق" Style="{StaticResource LinkButton}" Margin="0,0,12,0" Click="Close_Click" />
            <Button Content="حفظ الإعدادات" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</Window>
