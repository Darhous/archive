<Window x:Class="Darhous.Archive.Desktop.Views.ExplorerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:explorer="clr-namespace:Darhous.Archive.Desktop.ViewModels.Explorer"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:local="clr-namespace:Darhous.Archive.Desktop.Converters"
        Title="Darhous Smart Archive"
        Height="720" Width="1200"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}">
    <!-- SAD §37 (Archive Explorer). Real full-text search/pagination is Phase 8 — this
         proves the shell (tree/list/breadcrumb/bulk-actions/virtualization) end to end. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <local:EnumEqualsToVisibilityConverter x:Key="EnumEquals" />
    </Window.Resources>
    <DockPanel LastChildFill="True">

        <!-- Top bar: user + logout (SAD §14) -->
        <Grid DockPanel.Dock="Top" Background="{DynamicResource SecondarySurfaceBrush}" Height="44">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="UserText" Style="{StaticResource SecondaryText}"
                       VerticalAlignment="Center" Margin="16,0" />
            <Menu Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Margin="0,0,8,0">
                <MenuItem Header="التقارير">
                    <MenuItem Header="تصدير Excel" Tag="Excel" Click="ExportReport_Click" />
                    <MenuItem Header="تصدير CSV" Tag="Csv" Click="ExportReport_Click" />
                    <MenuItem Header="تصدير PDF" Tag="Pdf" Click="ExportReport_Click" />
                    <Separator />
                    <MenuItem Header="طباعة" Click="PrintReport_Click" />
                </MenuItem>
            </Menu>
            <ComboBox Grid.Column="2" VerticalAlignment="Center" Width="120" Margin="0,0,8,0"
                      ItemsSource="{Binding DensityOptions}" SelectedItem="{Binding Density}" />
            <ToggleButton Grid.Column="3" Content="معاينة" VerticalAlignment="Center" Margin="0,0,16,0"
                          IsChecked="{Binding ShowPreviewPane}" />
            <Button Grid.Column="4" Content="تسجيل الخروج" Style="{StaticResource LinkButton}"
                    Margin="0,0,16,0" Click="Logout_Click" />
        </Grid>

        <!-- Breadcrumb (§37.4) -->
        <TextBlock DockPanel.Dock="Top" Text="{Binding Breadcrumb}" Style="{StaticResource SecondaryText}"
                   Margin="16,8" />

        <!-- Search strip (§37.1 Live Filtering) -->
        <TextBox DockPanel.Dock="Top" Margin="16,0,16,8"
                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.Name="بحث في الأرشيف" />

        <!-- Bulk actions bar (§37.6) — only visible with a selection -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource SelectedSurfaceBrush}"
                Padding="16,8" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding SelectedDocumentCount, StringFormat='{}{0} محدد'}"
                           Style="{StaticResource BodyText}" VerticalAlignment="Center" Margin="0,0,16,0" />
                <ComboBox ItemsSource="{Binding RootNodes}" DisplayMemberPath="Name"
                          SelectedItem="{Binding MoveTargetFolder}" Width="180" Margin="0,0,8,0" />
                <Button Content="نقل" Style="{StaticResource PrimaryButton}" Command="{Binding MoveSelectedToFolderCommand}" Margin="0,0,8,0" />
                <Button Content="حذف" Style="{StaticResource PrimaryButton}" Command="{Binding DeleteSelectedCommand}" />
            </StackPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="280" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar / folder tree (§37, Outlook-style — SAD §20) -->
            <TreeView Grid.Column="0" x:Name="FolderTreeView" ItemsSource="{Binding RootNodes}"
                      BorderThickness="0" Background="{DynamicResource PrimarySurfaceBrush}"
                      SelectedItemChanged="FolderTreeView_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type explorer:FolderNodeViewModel}" ItemsSource="{Binding Children}">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource BodyText}" />
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <!-- Document list (§26, §37) — virtualized for the 100k-row gate (§41) -->
            <ListView Grid.Column="1" x:Name="DocumentListView" ItemsSource="{Binding Documents}"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Item"
                      SelectionMode="Extended"
                      SelectionChanged="DocumentListView_SelectionChanged"
                      BorderThickness="0" Background="{DynamicResource AppBackgroundBrush}">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="{Binding DataContext.RowPadding, RelativeSource={RelativeSource AncestorType=ListView}}" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="رقم الأرشيف" DisplayMemberBinding="{Binding ArchiveNumber}" Width="140" />
                        <GridViewColumn Header="العنوان" DisplayMemberBinding="{Binding Title}" Width="380" />
                        <GridViewColumn Header="الحالة" DisplayMemberBinding="{Binding Status}" Width="100" />
                        <GridViewColumn Header="تاريخ الأرشفة" DisplayMemberBinding="{Binding ArchiveDate}" Width="120" />
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Preview pane (SAD §21) — Header, Preview surface (PDF/Office fallback/unsupported), Metadata/Versions/Activity tabs -->
            <Border Grid.Column="2" Background="{DynamicResource SecondarySurfaceBrush}"
                    Visibility="{Binding ShowPreviewPane, Converter={StaticResource BoolToVisibility}}"
                    DataContext="{Binding Preview}">
              <Grid>

                <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="180" />
                    </Grid.RowDefinitions>

                    <!-- Header: Archive Number / Title / Date (SAD §21) -->
                    <StackPanel Grid.Row="0" Margin="12">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource BodyText}" FontWeight="Bold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ArchiveNumber}" Style="{StaticResource SecondaryText}" />
                        <TextBlock Text="{Binding ArchiveDate}" Style="{StaticResource SecondaryText}" />
                        <Button Content="فتح خارجيًا" Style="{StaticResource LinkButton}" HorizontalAlignment="Right"
                                Command="{Binding OpenExternallyCommand}" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Preview surface -->
                    <Grid Grid.Row="1" Margin="0,0,0,8">
                        <wv2:WebView2 x:Name="PdfPreview"
                                      Visibility="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Pdf}" />

                        <StackPanel Visibility="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=OfficeFallback}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" Margin="16">
                            <TextBlock Text="لا تتوفر معاينة مباشرة لهذا النوع من الملفات." Style="{StaticResource SecondaryText}"
                                       TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />
                            <Button Content="فتح الملف" Style="{StaticResource PrimaryButton}" Margin="0,8,0,0"
                                    Command="{Binding OpenExternallyCommand}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Visibility="{Binding Kind, Converter={StaticResource EnumEquals}, ConverterParameter=Unsupported}"
                                   Text="معاينة غير متاحة لهذا النوع من الملفات." Style="{StaticResource SecondaryText}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
                    </Grid>

                    <!-- Metadata / Versions / Activity tabs (SAD §21 — Underline style is a visual-polish follow-up; functionally lazy-loaded per Implementation Plan §59) -->
                    <TabControl Grid.Row="2" x:Name="PreviewTabs" BorderThickness="0,1,0,0" SelectionChanged="PreviewTabs_SelectionChanged">
                        <TabItem Header="Metadata">
                            <StackPanel Margin="8">
                                <TextBlock Style="{StaticResource SecondaryText}">
                                    <Run Text="الحالة: " /><Run Text="{Binding Status, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}">
                                    <Run Text="الحجم: " /><Run Text="{Binding FileSizeDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}">
                                    <Run Text="عدد الصفحات: " /><Run Text="{Binding PageCountDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}">
                                    <Run Text="حالة الفهرسة: " /><Run Text="{Binding ExtractionStatusDisplay, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource SecondaryText}" TextWrapping="Wrap">
                                    <Run Text="SHA-256: " /><Run Text="{Binding Sha256, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </TabItem>
                        <TabItem x:Name="VersionsTab" Header="الإصدارات">
                            <ListView ItemsSource="{Binding Versions}" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Style="{StaticResource BodyText}">
                                                <Run Text="v" /><Run Text="{Binding VersionNo, Mode=OneWay}" />
                                                <Run Text=" — " /><Run Text="{Binding OriginalFileName, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource SecondaryText}">
                                                <Run Text="{Binding ImportedAt, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding FileSizeDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabItem>
                        <TabItem x:Name="ActivityTab" Header="النشاط">
                            <ListView ItemsSource="{Binding ActivityEntries}" BorderThickness="0">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,4">
                                            <TextBlock Style="{StaticResource BodyText}" Text="{Binding Action}" />
                                            <TextBlock Style="{StaticResource SecondaryText}">
                                                <Run Text="{Binding Timestamp, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding UserDisplay, Mode=OneWay}" />
                                                <Run Text=" · " /><Run Text="{Binding ResultDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </TabItem>
                    </TabControl>
                </Grid>

                <TextBlock Text="اختر مستندًا لعرض معاينته" Style="{StaticResource SecondaryText}"
                           Visibility="{Binding NoSelection, Converter={StaticResource BoolToVisibility}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
              </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Window>
