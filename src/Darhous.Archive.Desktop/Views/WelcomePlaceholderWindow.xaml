<Window x:Class="Darhous.Archive.Desktop.Views.WelcomePlaceholderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Darhous Smart Archive"
        Height="300" Width="420"
        WindowStartupLocation="CenterScreen"
        FlowDirection="RightToLeft"
        Background="{DynamicResource AppBackgroundBrush}">
    <!-- Intentional placeholder: Archive Explorer UI is Phase 7 (Implementation Plan §40).
         This only proves the Phase 3 Login -> Session -> Principal chain works end to end. -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
        <TextBlock x:Name="WelcomeText" Style="{StaticResource BrandHeadingText}" FontSize="20"
                   TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="RoleText" Style="{StaticResource SecondaryText}" Margin="0,8,0,24"
                   HorizontalAlignment="Center" />
        <Button Content="تسجيل الخروج" Style="{StaticResource PrimaryButton}" Click="Logout_Click" />
    </StackPanel>
</Window>
