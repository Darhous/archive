<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UI/UX Design System §26 (Dark Mode Tokens) — same key names as Colors.Light.xaml so
         swapping this dictionary in is the entire theme switch (App.xaml.cs ApplyTheme). -->
    <Color x:Key="AppBackgroundColor">#171410</Color>
    <Color x:Key="PrimarySurfaceColor">#1F1B16</Color>
    <Color x:Key="SecondarySurfaceColor">#27221C</Color>
    <Color x:Key="HoverSurfaceColor">#302A22</Color>
    <Color x:Key="SelectedSurfaceColor">#392329</Color>
    <Color x:Key="BorderColor">#3D372E</Color>
    <Color x:Key="StrongBorderColor">#51493D</Color>
    <Color x:Key="PrimaryTextColor">#E9E5DA</Color>
    <Color x:Key="SecondaryTextColor">#B9B2A4</Color>
    <Color x:Key="DisabledTextColor">#817A6E</Color>
    <Color x:Key="AccentColor">#6C2631</Color>
    <Color x:Key="AccentHoverColor">#7C303D</Color>
    <Color x:Key="AccentPressedColor">#5C1F29</Color>

    <!-- UI/UX Design System §27 (Dark Functional Colors) -->
    <Color x:Key="SuccessColor">#5E7B61</Color>
    <Color x:Key="WarningColor">#B27A2A</Color>
    <Color x:Key="ErrorColor">#B45148</Color>
    <Color x:Key="ConfidentialColor">#52677C</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="{StaticResource PrimarySurfaceColor}" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="{StaticResource SelectedSurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ConfidentialBrush" Color="{StaticResource ConfidentialColor}" />

</ResourceDictionary>
