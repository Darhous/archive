<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- UI/UX Design System §24 (Light Mode Surface Tokens) -->
    <Color x:Key="AppBackgroundColor">#EBE8E0</Color>
    <Color x:Key="PrimarySurfaceColor">#F2F0EA</Color>
    <Color x:Key="SecondarySurfaceColor">#E4E0D6</Color>
    <Color x:Key="HoverSurfaceColor">#DED9CE</Color>
    <Color x:Key="SelectedSurfaceColor">#E7DADD</Color>
    <Color x:Key="BorderColor">#CDC7B9</Color>
    <Color x:Key="StrongBorderColor">#B7B09F</Color>
    <Color x:Key="PrimaryTextColor">#201D18</Color>
    <Color x:Key="SecondaryTextColor">#4A453B</Color>
    <Color x:Key="DisabledTextColor">#8B8578</Color>
    <Color x:Key="AccentColor">#74212E</Color>
    <Color x:Key="AccentHoverColor">#8A2A38</Color>
    <Color x:Key="AccentPressedColor">#641B27</Color>

    <!-- UI/UX Design System §23 (الألوان الوظيفية) -->
    <Color x:Key="SuccessColor">#3F5E43</Color>
    <Color x:Key="WarningColor">#8A5A12</Color>
    <Color x:Key="ErrorColor">#92302A</Color>
    <Color x:Key="ConfidentialColor">#2E4258</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}" />
    <SolidColorBrush x:Key="PrimarySurfaceBrush" Color="{StaticResource PrimarySurfaceColor}" />
    <SolidColorBrush x:Key="SecondarySurfaceBrush" Color="{StaticResource SecondarySurfaceColor}" />
    <SolidColorBrush x:Key="HoverSurfaceBrush" Color="{StaticResource HoverSurfaceColor}" />
    <SolidColorBrush x:Key="SelectedSurfaceBrush" Color="{StaticResource SelectedSurfaceColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="StrongBorderBrush" Color="{StaticResource StrongBorderColor}" />
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="{StaticResource DisabledTextColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
    <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource ErrorColor}" />
    <SolidColorBrush x:Key="ConfidentialBrush" Color="{StaticResource ConfidentialColor}" />

</ResourceDictionary>
